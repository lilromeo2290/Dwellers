# ==============================================================================
# DWELLERS — Find. Buy. Build.
# Environment configuration template
#
# Copy this file to `.env` (development) and fill in real values.
# NEVER commit real secrets to version control. `.env*` files are gitignored.
#
# Environments: development | staging | production
#   - Local development:            .env            (NODE_ENV=development)
#   - Staging/production deploys:   provide variables through the hosting
#                                   platform's secret manager (do not ship files)
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# Runtime environment label used by the app (falls back to NODE_ENV).
# One of: development | staging | production
APP_ENV=development

# Public base URL of the deployment (used for metadata, links, callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Human-readable deployment label shown in health/meta endpoints.
APP_NAME=Dwellers

# ------------------------------------------------------------------------------
# DATABASE (Prisma + SQLite in this phase)
# ------------------------------------------------------------------------------
# Path is resolved relative to prisma/schema.prisma.
# SQLite (current):    file:../db/custom.db
# PostgreSQL (future): postgres://user:password@host:5432/dwellers?schema=public
DATABASE_URL="file:../db/custom.db"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SESSIONS (NextAuth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# REQUIRED in staging/production. Sessions fail closed when missing there.
AUTH_SECRET=replace-with-a-long-random-secret

# NextAuth URL in production (defaults to NEXT_PUBLIC_APP_URL).
# NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# FILE STORAGE
# ------------------------------------------------------------------------------
# Driver: local (current) | s3 (planned — do not enable until implemented)
STORAGE_DRIVER=local
# Absolute or project-relative directory for the local driver.
STORAGE_LOCAL_PATH=./uploads
# Public CDN/S3 base URL when a cloud driver is enabled.
# STORAGE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# EMAIL / NOTIFICATIONS (optional — features activate when configured)
# ------------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Dwellers <no-reply@example.com>"

# ------------------------------------------------------------------------------
# SMS / WHATSAPP (optional — Ghana market: local providers supported later)
# ------------------------------------------------------------------------------
# SMS_PROVIDER=generic
# SMS_API_KEY=
# SMS_SENDER_ID=DWELLERS
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ------------------------------------------------------------------------------
# PAYMENTS (optional — Ghana Cedi settlements; configure before Phase: Commerce)
# ------------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# MOMO_SUBSCRIPTION_KEY=

# ------------------------------------------------------------------------------
# SEARCH / CACHE (optional infrastructure — local memory used by default)
# ------------------------------------------------------------------------------
# REDIS_URL=

# ------------------------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------------------------
# Log level: debug | info | warn | error (default: info in production)
LOG_LEVEL=debug
